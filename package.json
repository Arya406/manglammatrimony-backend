{
  "name": "manglammatrimony-backend",
  "version": "1.0.0",
  "description": "Manglam Matrimony Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "prisma": "6.4.1",
    "resend": "^6.26.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.19",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
