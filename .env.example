# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manglammatrimony_dev?schema=public"

# Authentication & Security
JWT_SECRET=manglam_matrimony_jwt_secret_dev_key_2026_secure
JWT_EXPIRY=7d

# OTP Configuration (6-digit, 10-minute expiry, 60s cooldown, max 5 attempts)
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=resend

# Photo & Storage Configuration
PHOTO_MAX_COUNT=6
PROFILE_IMAGE_MAX_UPLOAD_MB=20
PROFILE_IMAGE_MAX_PIXELS=40000000
PROFILE_IMAGE_OUTPUT_WIDTH=1200
PROFILE_IMAGE_OUTPUT_HEIGHT=1500
PROFILE_IMAGE_QUALITY=85
PHOTO_MIN_WIDTH=150
PHOTO_MIN_HEIGHT=150
PHOTO_MAX_WIDTH=10000
PHOTO_MAX_HEIGHT=10000

# Storage Configuration ('local' for development, 'r2' for production)
PHOTO_STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./storage
STORAGE_PUBLIC_BASE_URL=

# Cloudflare R2 Object Storage (Required when PHOTO_STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=manglammatrimony-photos
R2_PUBLIC_BASE_URL=https://media.manglammatrimony.com


# Development-Only Features (MUST BE false or omitted in production)
DEV_PHOTO_APPROVAL_ENABLED=false
DEV_DUMMY_OTP_ENABLED=false

# Resend Email Configuration (Official Resend SDK)
# Required in production; do not use onboarding@resend.dev in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
