// ==============================================================================
// Manglam Matrimony — Prisma Database Schema
// PostgreSQL Relational Foundation for Matrimonial Platform
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum ProfileCreatedFor {
  MYSELF
  MY_SON
  MY_DAUGHTER
  MY_BROTHER
  MY_SISTER
  MY_RELATIVE
  OTHER
}

enum ProfileStatus {
  INCOMPLETE
  IN_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

enum ManglikStatus {
  YES
  NO
  DONT_KNOW
  NOT_APPLICABLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  OTHER
}

enum AnnualIncomeRange {
  BELOW_2_LAKH
  TWO_TO_FIVE_LAKH
  FIVE_TO_TEN_LAKH
  TEN_TO_FIFTEEN_LAKH
  FIFTEEN_TO_TWENTY_LAKH
  TWENTY_TO_THIRTY_LAKH
  THIRTY_TO_FIFTY_LAKH
  FIFTY_LAKH_TO_ONE_CRORE
  ABOVE_ONE_CRORE
  PREFER_NOT_TO_SAY
}

enum PhotoType {
  PRIMARY
  ADDITIONAL
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==============================================================================
// CORE ENTITIES (1 - 8)
// ==============================================================================

/// Represents the authenticated user account.
model User {
  id               String      @id @default(uuid()) @map("id")
  phone            String?     @unique @map("phone")
  email            String?     @unique @map("email")
  phoneVerifiedAt  DateTime?   @map("phone_verified_at")
  emailVerifiedAt  DateTime?   @map("email_verified_at")
  status           UserStatus  @default(ACTIVE) @map("status")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  profile                   Profile?
  sentMessageRequests       MessageRequest[]           @relation("SentMessageRequests")
  receivedMessageRequests   MessageRequest[]           @relation("ReceivedMessageRequests")
  conversationsAsUserOne    Conversation[]             @relation("ConversationUserOne")
  conversationsAsUserTwo    Conversation[]             @relation("ConversationUserTwo")
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]                  @relation("SentMessages")
  notifications             Notification[]
  favouritesSent            ProfileFavourite[]         @relation("UserFavourites")

  @@index([phone])
  @@index([email])
  @@map("users")
}

/// Represents the core matrimonial profile linked to a user.
model Profile {
  id                    String             @id @default(uuid()) @map("id")
  userId                String             @unique @map("user_id")
  profileCreatedFor     ProfileCreatedFor  @map("profile_created_for")
  profileStatus         ProfileStatus      @default(INCOMPLETE) @map("profile_status")
  completionPercentage  Int                @default(0) @map("completion_percentage")
  submittedAt           DateTime?          @map("submitted_at")
  reviewedAt            DateTime?          @map("reviewed_at")
  rejectionReason       String?            @map("rejection_reason")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalDetails       ProfilePersonalDetails?
  religion              ProfileReligion?
  education             ProfileEducation?
  career                ProfileCareer?
  photos                ProfilePhoto[]
  partnerPreference     PartnerPreference?
  languages             ProfileLanguage[]
  favouritesReceived    ProfileFavourite[]         @relation("ProfileReceivedFavourites")

  @@index([userId])
  @@index([profileStatus])
  @@index([profileCreatedFor])
  @@map("profiles")
}

/// One-to-one personal details for a matrimonial profile.
model ProfilePersonalDetails {
  id              String         @id @default(uuid()) @map("id")
  profileId       String         @unique @map("profile_id")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  gender          Gender         @map("gender")
  dateOfBirth     DateTime       @map("date_of_birth")
  maritalStatus   MaritalStatus  @map("marital_status")
  heightCm        Int            @map("height_cm")
  motherTongueId  String         @map("mother_tongue_id")
  city            String?        @map("city")
  state           String?        @map("state")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  motherTongue    Language       @relation(fields: [motherTongueId], references: [id], onDelete: Restrict)

  @@index([gender])
  @@index([dateOfBirth])
  @@index([heightCm])
  @@index([motherTongueId])
  @@index([city])
  @@index([state])
  @@map("profile_personal_details")
}

/// Junction table for multiple languages spoken by a profile.
model ProfileLanguage {
  profileId   String    @map("profile_id")
  languageId  String    @map("language_id")

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([profileId, languageId])
  @@map("profile_languages")
}

/// One-to-one religious and community details for a profile.
model ProfileReligion {
  id              String         @id @default(uuid()) @map("id")
  profileId       String         @unique @map("profile_id")
  religionId      String         @map("religion_id")
  communityId     String?        @map("community_id")
  subCommunityId  String?        @map("sub_community_id")
  casteId         String?        @map("caste_id")
  subCasteId      String?        @map("sub_caste_id")
  gotraId         String?        @map("gotra_id")
  manglik         ManglikStatus  @map("manglik")
  customReligion  String?        @map("custom_religion")
  customCommunity String?        @map("custom_community")
  customCaste     String?        @map("custom_caste")
  customSubCaste  String?        @map("custom_sub_caste")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  religion        Religion       @relation(fields: [religionId], references: [id], onDelete: Restrict)
  community       Community?     @relation(fields: [communityId], references: [id], onDelete: Restrict)
  subCommunity    SubCommunity?  @relation(fields: [subCommunityId], references: [id], onDelete: Restrict)
  caste           Caste?         @relation(fields: [casteId], references: [id], onDelete: Restrict)
  subCaste        SubCaste?      @relation(fields: [subCasteId], references: [id], onDelete: Restrict)
  gotra           Gotra?         @relation(fields: [gotraId], references: [id], onDelete: Restrict)

  @@index([religionId])
  @@index([communityId])
  @@index([casteId])
  @@index([gotraId])
  @@index([manglik])
  @@map("profile_religion")
}

/// One-to-one education details for a profile.
model ProfileEducation {
  id                String          @id @default(uuid()) @map("id")
  profileId         String          @unique @map("profile_id")
  educationId       String          @map("education_id")
  specializationId  String?         @map("specialization_id")
  institutionId     String?         @map("institution_id")
  institutionName   String?         @map("institution_name")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  education         Education       @relation(fields: [educationId], references: [id], onDelete: Restrict)
  specialization    Specialization? @relation(fields: [specializationId], references: [id], onDelete: Restrict)
  institution       Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([educationId])
  @@index([specializationId])
  @@index([institutionId])
  @@map("profile_education")
}

/// One-to-one career and financial range details for a profile.
model ProfileCareer {
  id                  String             @id @default(uuid()) @map("id")
  profileId           String             @unique @map("profile_id")
  employmentStatusId  String             @map("employment_status_id")
  occupationId        String?            @map("occupation_id")
  companyName         String?            @map("company_name")
  employmentType      EmploymentType?    @map("employment_type")
  annualIncomeRange   AnnualIncomeRange? @map("annual_income_range")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  profile             Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  employmentStatus    EmploymentStatus   @relation(fields: [employmentStatusId], references: [id], onDelete: Restrict)
  occupation          Occupation?        @relation(fields: [occupationId], references: [id], onDelete: Restrict)

  @@index([employmentStatusId])
  @@index([occupationId])
  @@index([annualIncomeRange])
  @@map("profile_career")
}

/// Metadata and storage key references for profile photos.
model ProfilePhoto {
  id                String            @id @default(uuid()) @map("id")
  profileId         String            @map("profile_id")
  storageKey        String            @map("storage_key")
  originalFileName  String            @map("original_file_name")
  mimeType          String            @map("mime_type")
  fileSize          Int               @map("file_size")
  width             Int?              @map("width")
  height            Int?              @map("height")
  photoType         PhotoType         @map("photo_type")
  moderationStatus  ModerationStatus  @default(PENDING) @map("moderation_status")
  moderationReason  String?           @map("moderation_reason")
  sortOrder         Int               @default(0) @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([moderationStatus])
  @@index([photoType])
  @@map("profile_photos")
}

/// One-to-one partner preference criteria for matrimonial matching.
model PartnerPreference {
  id              String                             @id @default(uuid()) @map("id")
  profileId       String                             @unique @map("profile_id")
  minAge          Int?                               @map("min_age")
  maxAge          Int?                               @map("max_age")
  minHeightCm     Int?                               @map("min_height_cm")
  maxHeightCm     Int?                               @map("max_height_cm")
  createdAt       DateTime                           @default(now()) @map("created_at")
  updatedAt       DateTime                           @updatedAt @map("updated_at")

  profile         Profile                            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  religions       PartnerPreferenceReligion[]
  communities     PartnerPreferenceCommunity[]
  subCommunities  PartnerPreferenceSubCommunity[]
  castes          PartnerPreferenceCaste[]
  gotras          PartnerPreferenceGotra[]
  educations      PartnerPreferenceEducation[]
  occupations     PartnerPreferenceOccupation[]
  manglik         PartnerPreferenceManglik[]
  maritalStatuses PartnerPreferenceMaritalStatus[]

  @@index([profileId])
  @@map("partner_preferences")
}

// ==============================================================================
// PARTNER PREFERENCE JUNCTION TABLES
// ==============================================================================

model PartnerPreferenceReligion {
  partnerPreferenceId String             @map("partner_preference_id")
  religionId          String             @map("religion_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  religion            Religion           @relation(fields: [religionId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, religionId])
  @@map("partner_preference_religions")
}

model PartnerPreferenceCommunity {
  partnerPreferenceId String             @map("partner_preference_id")
  communityId         String             @map("community_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  community           Community          @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, communityId])
  @@map("partner_preference_communities")
}

model PartnerPreferenceSubCommunity {
  partnerPreferenceId String             @map("partner_preference_id")
  subCommunityId      String             @map("sub_community_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  subCommunity        SubCommunity       @relation(fields: [subCommunityId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, subCommunityId])
  @@map("partner_preference_sub_communities")
}

model PartnerPreferenceCaste {
  partnerPreferenceId String             @map("partner_preference_id")
  casteId             String             @map("caste_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  caste               Caste              @relation(fields: [casteId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, casteId])
  @@map("partner_preference_castes")
}

model PartnerPreferenceGotra {
  partnerPreferenceId String             @map("partner_preference_id")
  gotraId             String             @map("gotra_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  gotra               Gotra              @relation(fields: [gotraId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, gotraId])
  @@map("partner_preference_gotras")
}

model PartnerPreferenceEducation {
  partnerPreferenceId String             @map("partner_preference_id")
  educationId         String             @map("education_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  education           Education          @relation(fields: [educationId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, educationId])
  @@map("partner_preference_educations")
}

model PartnerPreferenceOccupation {
  partnerPreferenceId String             @map("partner_preference_id")
  occupationId        String             @map("occupation_id")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  occupation          Occupation         @relation(fields: [occupationId], references: [id], onDelete: Restrict)

  @@id([partnerPreferenceId, occupationId])
  @@map("partner_preference_occupations")
}

model PartnerPreferenceManglik {
  partnerPreferenceId String             @map("partner_preference_id")
  manglik             ManglikStatus      @map("manglik")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)

  @@id([partnerPreferenceId, manglik])
  @@map("partner_preference_manglik")
}

model PartnerPreferenceMaritalStatus {
  partnerPreferenceId String             @map("partner_preference_id")
  maritalStatus       MaritalStatus      @map("marital_status")

  partnerPreference   PartnerPreference  @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)

  @@id([partnerPreferenceId, maritalStatus])
  @@map("partner_preference_marital_statuses")
}

// ==============================================================================
// MASTER DATA ENTITIES (9 - 20)
// ==============================================================================

model Language {
  id                      String                   @id @default(uuid()) @map("id")
  name                    String                   @map("name")
  code                    String                   @unique @map("code")
  isActive                Boolean                  @default(true) @map("is_active")
  sortOrder               Int                      @default(0) @map("sort_order")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  profilePersonalDetails  ProfilePersonalDetails[]
  profileLanguages        ProfileLanguage[]

  @@map("languages")
}

model Religion {
  id                  String                       @id @default(uuid()) @map("id")
  name                String                       @map("name")
  slug                String                       @unique @map("slug")
  isActive            Boolean                      @default(true) @map("is_active")
  sortOrder           Int                          @default(0) @map("sort_order")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  communities         Community[]
  profileReligions    ProfileReligion[]
  partnerPreferences  PartnerPreferenceReligion[]

  @@map("religions")
}

model Community {
  id                  String                       @id @default(uuid()) @map("id")
  religionId          String?                      @map("religion_id")
  name                String                       @map("name")
  slug                String                       @unique @map("slug")
  isActive            Boolean                      @default(true) @map("is_active")
  sortOrder           Int                          @default(0) @map("sort_order")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  religion            Religion?                    @relation(fields: [religionId], references: [id], onDelete: Restrict)
  subCommunities      SubCommunity[]
  castes              Caste[]
  gotras              Gotra[]
  profileReligions    ProfileReligion[]
  partnerPreferences  PartnerPreferenceCommunity[]

  @@map("communities")
}

model SubCommunity {
  id                  String                          @id @default(uuid()) @map("id")
  communityId         String                          @map("community_id")
  name                String                          @map("name")
  slug                String                          @map("slug")
  isActive            Boolean                         @default(true) @map("is_active")
  sortOrder           Int                             @default(0) @map("sort_order")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")

  community           Community                       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  profileReligions    ProfileReligion[]
  partnerPreferences  PartnerPreferenceSubCommunity[]

  @@unique([communityId, slug])
  @@map("sub_communities")
}

model Caste {
  id                  String                    @id @default(uuid()) @map("id")
  communityId         String?                   @map("community_id")
  name                String                    @map("name")
  slug                String                    @map("slug")
  isActive            Boolean                   @default(true) @map("is_active")
  sortOrder           Int                       @default(0) @map("sort_order")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  community           Community?                @relation(fields: [communityId], references: [id], onDelete: Restrict)
  subCastes           SubCaste[]
  profileReligions    ProfileReligion[]
  partnerPreferences  PartnerPreferenceCaste[]

  @@map("castes")
}

model SubCaste {
  id                  String            @id @default(uuid()) @map("id")
  casteId             String            @map("caste_id")
  name                String            @map("name")
  slug                String            @map("slug")
  isActive            Boolean           @default(true) @map("is_active")
  sortOrder           Int               @default(0) @map("sort_order")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  caste               Caste             @relation(fields: [casteId], references: [id], onDelete: Restrict)
  profileReligions    ProfileReligion[]

  @@unique([casteId, slug])
  @@map("sub_castes")
}

model Gotra {
  id                  String                    @id @default(uuid()) @map("id")
  communityId         String?                   @map("community_id")
  name                String                    @map("name")
  slug                String                    @map("slug")
  isActive            Boolean                   @default(true) @map("is_active")
  sortOrder           Int                       @default(0) @map("sort_order")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  community           Community?                @relation(fields: [communityId], references: [id], onDelete: Restrict)
  profileReligions    ProfileReligion[]
  partnerPreferences  PartnerPreferenceGotra[]

  @@map("gotras")
}

model Education {
  id                  String                        @id @default(uuid()) @map("id")
  name                String                        @map("name")
  slug                String                        @unique @map("slug")
  isActive            Boolean                       @default(true) @map("is_active")
  sortOrder           Int                           @default(0) @map("sort_order")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")

  specializations     Specialization[]
  profileEducations   ProfileEducation[]
  partnerPreferences  PartnerPreferenceEducation[]

  @@map("educations")
}

model Specialization {
  id                  String              @id @default(uuid()) @map("id")
  educationId         String              @map("education_id")
  name                String              @map("name")
  slug                String              @map("slug")
  isActive            Boolean             @default(true) @map("is_active")
  sortOrder           Int                 @default(0) @map("sort_order")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  education           Education           @relation(fields: [educationId], references: [id], onDelete: Restrict)
  profileEducations   ProfileEducation[]

  @@unique([educationId, slug])
  @@map("specializations")
}

model Institution {
  id                  String              @id @default(uuid()) @map("id")
  name                String              @map("name")
  normalizedName      String              @map("normalized_name")
  type                String?             @map("type")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  profileEducations   ProfileEducation[]

  @@index([normalizedName])
  @@map("institutions")
}

model EmploymentStatus {
  id                  String             @id @default(uuid()) @map("id")
  name                String             @map("name")
  slug                String             @unique @map("slug")
  isActive            Boolean            @default(true) @map("is_active")
  sortOrder           Int                @default(0) @map("sort_order")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  occupations         Occupation[]
  profileCareers      ProfileCareer[]

  @@map("employment_statuses")
}

model Occupation {
  id                  String                         @id @default(uuid()) @map("id")
  employmentStatusId  String                         @map("employment_status_id")
  name                String                         @map("name")
  slug                String                         @map("slug")
  isActive            Boolean                        @default(true) @map("is_active")
  sortOrder           Int                            @default(0) @map("sort_order")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  employmentStatus    EmploymentStatus               @relation(fields: [employmentStatusId], references: [id], onDelete: Restrict)
  profileCareers      ProfileCareer[]
  partnerPreferences  PartnerPreferenceOccupation[]

  @@unique([employmentStatusId, slug])
  @@map("occupations")
}

// ==============================================================================
// 9. MESSAGING & COMMUNICATION SYSTEM
// ==============================================================================

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  MESSAGE_REQUEST_RECEIVED
  MESSAGE_REQUEST_ACCEPTED
  MESSAGE_REQUEST_DECLINED
}

model MessageRequest {
  id             String               @id @default(uuid()) @map("id")
  senderUserId   String               @map("sender_user_id")
  receiverUserId String               @map("receiver_user_id")
  status         MessageRequestStatus @default(PENDING) @map("status")
  respondedAt    DateTime?            @map("responded_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  sender         User                 @relation("SentMessageRequests", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiver       User                 @relation("ReceivedMessageRequests", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([receiverUserId, status])
  @@index([senderUserId, status])
  @@index([senderUserId, receiverUserId])
  @@index([createdAt])
  @@map("message_requests")
}

model Conversation {
  id           String                    @id @default(uuid()) @map("id")
  userOneId    String                    @map("user_one_id")
  userTwoId    String                    @map("user_two_id")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  userOne      User                      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo      User                      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @map("id")
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @map("id")
  conversationId String       @map("conversation_id")
  senderUserId   String       @map("sender_user_id")
  body           String       @map("body") @db.Text
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([readAt])
  @@map("messages")
}

model Notification {
  id                    String           @id @default(uuid()) @map("id")
  userId                String           @map("user_id")
  type                  NotificationType @map("type")
  title                 String           @map("title")
  body                  String           @map("body")
  relatedRequestId      String?          @map("related_request_id")
  relatedConversationId String?          @map("related_conversation_id")
  readAt                DateTime?        @map("read_at")
  createdAt             DateTime         @default(now()) @map("created_at")

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==============================================================================
// FAVOURITES & LIKES
// ==============================================================================

model ProfileFavourite {
  id              String   @id @default(uuid()) @map("id")
  userId          String   @map("user_id")
  targetProfileId String   @map("target_profile_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User     @relation("UserFavourites", fields: [userId], references: [id], onDelete: Cascade)
  targetProfile   Profile  @relation("ProfileReceivedFavourites", fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, targetProfileId])
  @@index([userId])
  @@index([targetProfileId])
  @@index([createdAt])
  @@map("profile_favourites")
}

// ==============================================================================
// AUTHENTICATION & EMAIL OTP VERIFICATION
// ==============================================================================

model VerificationOtp {
  id                String    @id @map("id")
  email             String    @map("email")
  hashedOtp         String    @map("hashed_otp")
  salt              String    @map("salt")
  attempts          Int       @default(0) @map("attempts")
  maxAttempts       Int       @default(5) @map("max_attempts")
  expiresAt         DateTime  @map("expires_at")
  resendAvailableAt DateTime  @map("resend_available_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([expiresAt])
  @@map("verification_otps")
}

